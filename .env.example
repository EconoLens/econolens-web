# EconoLens — Environment Variables
# Copy this to .env.local and fill in values
# NEVER commit .env.local — it's in .gitignore
# All real values are in: 1Password → EconoLens Production vault
# And: vercel.com → khagan-s-projects → econolens-web → Settings → Environment Variables

# ── SANITY CMS ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=rvv43603
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=                          # From: sanity.io/manage/project/rvv43603 → API → Tokens

# ── SUPABASE ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                  # From: supabase.com dashboard
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # Anon/public key
SUPABASE_SERVICE_ROLE_KEY=                 # Secret — server-side only

# ── CLERK (AUTH) ────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=         # pk_live_...
CLERK_SECRET_KEY=                          # sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── ANTHROPIC ───────────────────────────────────────────────
ANTHROPIC_API_KEY=                         # sk-ant-...

# ── BEEHIIV ─────────────────────────────────────────────────
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ── BUFFER ──────────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=

# ── PAYMENTS (Phase 2) ──────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CONTENT & MARKETING ─────────────────────────────────────
COPYSCAPE_USERNAME=
COPYSCAPE_API_KEY=
FRED_API_KEY=

# ── SITE ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://econolens.co.in
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-JKGQJFE2X0
